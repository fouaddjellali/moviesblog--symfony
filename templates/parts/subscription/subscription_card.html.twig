<li class="relative w-full block">
    <a href="#" 
       class="block border-4 border-red-600 rounded-lg p-6 transition hover:bg-red-50 focus:ring-2 focus:ring-red-400" 
       aria-label="Détails de l'abonnement {{ subscription.name }}">
        <div class="flex flex-row items-center justify-between">
            <div>
                <h3 class="font-bold text-lg text-gray-900">{{ subscription.name }}</h3>
                <span class="font-medium text-sm text-gray-500">Le moins cher</span>
            </div>
            <span class="text-3xl font-bold text-gray-900">{{ subscription.price }}€</span>
        </div>
        <p class="mt-4 text-gray-700">
            Abonnement de {{ subscription.duration }} mois
        </p>
        <div class="mt-6">
            <button 
                class="w-full bg-red-600 px-4 py-3 text-white font-medium rounded-md hover:bg-red-700 focus:ring-2 focus:ring-red-400 transition">
                S'abonner
            </button>
        </div>
    </a>
</li>
