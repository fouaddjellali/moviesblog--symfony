<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Streemi - Gestion des Médias</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="font-montserrat text-sm bg-white">
<div class="flex min-h-screen 2xl:max-w-screen-2xl 2xl:mx-auto 2xl:border-x-2 2xl:border-gray-200">
    {% include 'parts/menu-left.html.twig' %}
    <main class="flex-1 py-10 px-5 sm:px-10">
        <section>
            <h1 class="text-lg font-medium text-black mb-9">Ajouter un <span class="font-bold text-red-600">contenu multimédia</span></h1>
            <a href="{{ path('admin_movies') }}" class="underline decoration-2 decoration-red-400 hover:text-red-600 inline-flex items-center">
                <svg class="fill-current h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"/>
                </svg>
                Retourner à la liste des contenus
            </a>
        </section>
        <section class="mt-9">
            {{ form_start(form, {'attr': {'class': 'mt-10 space-y-3'}}) }}
            <div class="relative flex space-x-3">
                <div class="w-2/3">{{ form_row(form.title) }}</div>
                <div class="w-1/3">{{ form_row(form.type) }}</div>
            </div>
            {{ form_row(form.coverImage, {attr: {placeholder: 'Image de couverture'}}) }}
            {{ form_row(form.shortDescription, {attr: {placeholder: 'Résumé court'}}) }}
            {{ form_row(form.longDescription, {attr: {placeholder: 'Description détaillée'}}) }}
            {{ form_row(form.categories, {attr: {placeholder: 'Genres'}}) }}
            <div class="relative flex space-x-3">
                <div class="w-1/2">{{ form_row(form.languages, {attr: {placeholder: 'Langues disponibles'}}) }}</div>
                <div class="w-1/2">{{ form_row(form.subtitles, {attr: {placeholder: 'Sous-titres disponibles'}}) }}</div>
            </div>
            {{ form_row(form.releaseDate) }}
            <div class="relative flex space-x-3">
                <input class="w-1/3 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" id="releasedate" type="date" placeholder="Date de sortie"/>
                <input class="w-1/3 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" id="duration" type="text" placeholder="Durée en minutes"/>
                <input class="w-1/3 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" id="note" type="text" placeholder="Note globale"/>
            </div>
            <div class="relative flex space-x-3">
                <input class="w-1/2 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" id="youtube-trailer" type="text" placeholder="Lien Youtube de la bande-annonce"/>
                <input class="w-1/2 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" id="allocine-trailer" type="text" placeholder="Lien Allociné de la bande-annonce"/>
            </div>
            <div class="relative flex space-x-3">
                <h2 class="text-lg font-medium text-black mt-8">Liste des <span class="font-bold text-red-600">épisodes</span></h2>
            </div>
            <div class="relative flex space-x-3">
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="text" placeholder="Titre de l'épisode"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="text" placeholder="Numéro (S1E01)"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="url" placeholder="Lien vers l'image"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="url" placeholder="Description de l'épisode"/>
            </div>
            <button class="relative flex w-auto bg-red-600 flex-row p-2 items-center justify-center rounded-lg overflow-hidden border cursor-pointer transition text-white hover:opacity-90 hover:scale-105">
                <svg class="h-5 w-5 mr-3" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                </svg>
                Ajouter un épisode
            </button>
            <div class="relative flex space-x-3">
                <h2 class="text-lg font-medium text-black mt-8">Équipe de <span class="font-bold text-red-600">production</span></h2>
            </div>
            <div class="relative flex space-x-3">
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="text" placeholder="Nom du membre"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="text" placeholder="Rôle"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="url" placeholder="Image"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="url" placeholder="Lien associé"/>
            </div>
            <button class="relative flex w-auto bg-red-600 flex-row p-2 items-center justify-center rounded-lg overflow-hidden border cursor-pointer transition text-white hover:opacity-90 hover:scale-105">
                <svg class="h-5 w-5 mr-3" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                </svg>
                Ajouter un membre
            </button>
            <div class="relative flex space-x-3">
                <h2 class="text-lg font-medium text-black mt-8">Liste des <span class="font-bold text-red-600">acteurs</span></h2>
            </div>
            <div class="relative flex space-x-3">
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="text" placeholder="Nom"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="text" placeholder="Rôle"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="url" placeholder="Image"/>
                <input class="w-1/4 px-8 py-4 rounded-lg font-medium bg-gray-100 border border-gray-200 placeholder-gray-500 text-sm focus:outline-none focus:border-gray-400 focus:bg-white" type="url" placeholder="Lien associé"/>
            </div>
            <button class="relative flex w-auto bg-red-600 flex-row p-2 items-center justify-center rounded-lg overflow-hidden border cursor-pointer transition text-white hover:opacity-90 hover:scale-105">
                <svg class="h-5 w-5 mr-3" fill="currentColor" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M17,13H13V17H11V13H7V11H11V7H13V11H17M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"/>
                </svg>
                Ajouter un acteur
            </button>
            <div class="!mt-20">
                {{ form_row(form.submit, {attr: {class: 'w-full bg-red-600 flex-row p-3 items-center justify-center rounded-lg overflow-hidden border cursor-pointer transition text-white hover:opacity-90 hover:scale-105'}}) }}
            </div>
            {{ form_end(form) }}
        </section>
    </main>
</div>
</body>
</html>